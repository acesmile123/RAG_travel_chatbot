# ====================== QDRANT CONFIGURATION ======================
# Qdrant vector database for RAG retrieval
QDRANT_URL=https://your-qdrant-instance.cloud
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=vietnam_travel

# ====================== EMBEDDING & RERANKING ======================
# HuggingFace models for embeddings and reranking
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
HF_TOKEN=your_huggingface_token_here

# ====================== OLLAMA CONFIGURATION ======================
# Ollama server for LLM inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60.0

# Two-Model Architecture:
# Model A: Lightweight model for RAG internal logic (query rewriting, routing, filtering)
# Model B: Fine-tuned model for final answer generation
RETRIEVER_MODEL=qwen3:1.7b
GENERATOR_MODEL=qwen3finetune:latest

# ====================== DATABASE CONFIGURATION ======================
# PostgreSQL database for persistent chat history
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_chatbot
